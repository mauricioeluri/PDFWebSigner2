    flex-direction: column;
    max-width: none;
    height: 100dvh;
    border: 0;
    border-radius: 0;
  }
  .is-open .appbar {
    display: none;
  }
  .editor {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }
  .desk {
    flex: 1;
    min-height: 0;
