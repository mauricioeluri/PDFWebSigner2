    --desk: light-dark(#eef1f3, #15191e);
    --accent: light-dark(#164c42, #9fe0cd);
    --inverse: light-dark(#fff, #112a24);
    --paper: light-dark(#fff, #f5f4f0);
    color-scheme: light dark;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--edge);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink);
    font:
      14px/1.45 system-ui,
      sans-serif;
  }

  [hidden] {
    display: none !important;
  }

  button {
    min-height: 36px;
    padding: 8px 12px;
    border: 0;
    border-radius: 7px;
    font: inherit;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  button:focus-visible,
  input:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .primary {
    background: var(--accent);
    color: var(--inverse);
  }
  .primary:hover:enabled {
    filter: brightness(1.12);
  }
  .quiet {
    background: transparent;
    color: var(--ink);
  }
  .quiet:hover:enabled {
    background: var(--desk);
  }
  select {
    padding: 6px;
    border: 1px solid var(--edge);
    border-radius: 5px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }

  .appbar {
    display: flex;
    align-items: center;
    min-height: 38px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--edge);
  }
  .appbar strong {
    font-size: 15px;
  }
  .start {
    position: relative;
    display: grid;
    place-items: center;
    min-height: min(65vh, 540px);
    padding: 20px;
    text-align: center;
  }
  .intro h1 {
    margin: 0;
    font-size: 26px;
    letter-spacing: -0.035em;
  }
  .intro p {
    margin: 8px 0 24px;
