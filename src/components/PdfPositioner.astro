<div id="pdf-design">
  <header class="appbar">
    <strong>PDFWebSigner</strong>
  </header>
  <section class="start" aria-label="Abrir PDF">
    <div class="intro">
      <h1>Posicione um campo de assinatura no PDF</h1>
      <p>Marque a área e copie as coordenadas ou um comando para o pyHanko.</p>
      <div class="open-options">
        <span>Arraste um PDF para esta página ou</span>
        <button class="primary open" type="button">
          Escolher PDF
        </button>
      </div>
      <input
        class="file-input"
        type="file"
        accept="application/pdf,.pdf"
        hidden
      />
    </div>
  </section>
  <p class="feedback" role="status" aria-live="polite" hidden></p>
  <section
    class="editor"
    aria-label="Posicionador de campos de assinatura para pyHanko"
    hidden
  >
    <div class="toolbar" role="group" aria-label="Controles do PDF">
      <div class="pagination">
        <div class="page-navigation">
          <button
            class="quiet prev"
            aria-label="Página anterior"
            type="button"
            title="Página anterior"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 15 7-7 7 7" />
            </svg>
          </button>
          <button
            class="quiet next"
            aria-label="Próxima página"
            type="button"
            title="Próxima página"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 9 7 7 7-7" />
            </svg>
          </button>
          <input
            class="page-number"
            type="text"
            inputmode="numeric"
            value="1"
            aria-label="Página atual"
            title="Digite o número da página e pressione Enter"
            autocomplete="off"
            disabled
          />
          <span class="page-count">de —</span>
        </div>
        <label
          class="pin-option"
          title="Mantém a área de assinatura na última página, mesmo quando o número de páginas do PDF mudar."
        >
          <input class="pin-last" type="checkbox" /> Sempre na última página
        </label>
      </div>
      <div class="zoom-controls" role="group" aria-label="Zoom">
        <button
          class="quiet zoom-out"
          type="button"
          aria-label="Diminuir zoom"
          title="Diminuir zoom"
          disabled
        >
          −
        </button>
        <button
          class="quiet zoom-in"
          type="button"
          aria-label="Aumentar zoom"
          title="Aumentar zoom"
          disabled
        >
          +
        </button>
        <select class="zoom" aria-label="Zoom do PDF">
          <option value="0">Ajustar largura</option>
          <option value="0.5">50%</option>
          <option value="0.75" selected>
            75%
          </option>
          <option value="1">100%</option>
          <option value="1.25">125%</option>
          <option value="1.5">150%</option>
          <option value="2">200%</option>
          <option value="3">300%</option>
        </select>
      </div>
      <div class="document-actions">
        <span class="file" hidden></span>
        <div class="export" role="group" aria-label="Ações da seleção" hidden>
          <button
            class="quiet selection-page"
            type="button"
            title="Ir à área de assinatura"
            disabled
          ></button>
          <button class="quiet clear" type="button" disabled>
            Limpar
          </button>
          <button
            class="quiet copy-pos"
            type="button"
            title="Copiar coordenadas para uso no pyHanko"
            disabled
          >
            Copiar coordenadas
          </button>
          <button
            class="quiet copy-cmd"
            type="button"
            disabled
            aria-label="Copiar comando pyHanko"
            title="Copia um comando pyHanko que cria um campo vazio; não assina o PDF"
          >
            Comando pyHanko
          </button>
        </div>
        <button
          class="quiet close"
          type="button"
          aria-label="Fechar PDF"
          title="Fechar PDF"
          hidden
        >
          ×
        </button>
      </div>
      <button
        class="quiet more"
        type="button"
        popovertarget="editor-options"
        aria-label="Mais opções"
        title="Mais opções"
      >
        ⋯
      </button>
    </div>
    <div id="editor-options" popover aria-label="Opções do PDF">
      <label class="menu-zoom" hidden>
        Zoom
      </label>
    </div>
    <div
      class="desk"
      tabindex="0"
      aria-label="Documento PDF com rolagem entre páginas"
    >
      <div class="sheet" hidden>
        <canvas aria-label="Página do PDF"></canvas>
        <div
          class="selection-layer"
          aria-label="Arraste ou dê um duplo clique para posicionar a área de assinatura"
        >
          <div class="mark" hidden>
            <span>Campo de assinatura</span>
            <span class="handle nw" data-corner="nw"></span>
            <span class="handle ne" data-corner="ne"></span>
            <span class="handle sw" data-corner="sw"></span>
            <span class="handle se" data-corner="se"></span>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
<script>
  import './pdf-positioner'
</script>
<style>
